---
layout: layout.njk
title: Status
description: "Latest crawler runs and notes."
page_type: status
---

<div class="status-chart-shell">
  <div class="status-chart-toolbar" data-status-chart-toolbar hidden>
    <div class="status-chart-search-group">
      <label class="screenreader-only" for="status-notes-search">Search run notes</label>
      <input
        type="search"
        class="status-chart-search"
        id="status-notes-search"
        data-status-notes-search
        aria-keyshortcuts="s"
        aria-describedby="status-package-search-tip"
        placeholder="Search notes"
        autocomplete="off"
        spellcheck="false"
      >
      <span
        class="status-package-search-tip"
        id="status-package-search-tip"
        data-status-package-search-tip
        role="tooltip"
        hidden
      >Type or paste your package name here.</span>
      <span
        class="status-package-lock"
        data-status-package-lock
        role="status"
        aria-live="polite"
        hidden
      >
        Locked to package <a data-status-package-link target="_blank" rel="noopener">“<span class="status-package-link-label" data-status-package-link-label></span>”</a>
      </span>
      <span
        class="status-package-suggestion"
        data-status-package-suggestion
        aria-live="polite"
        hidden
      >
        Did you mean
        <button
          type="button"
          class="status-package-suggestion-button"
          data-status-package-suggestion-button
        ></button>?
      </span>
    </div>
    <button type="button" class="status-chart-mode-button" data-status-mode-toggle aria-pressed="false">
      Which runs actually found updates?
    </button>
  </div>
  <div class="status-chart" data-status-chart aria-hidden="true">
    <svg role="presentation"></svg>
  </div>
</div>

<section class="status-page">
  <div class="pager-header">
    <div class="status-heading" role="heading" aria-level="2">
      <span class="status-badge status-badge-muted" data-status-badge></span>
      <span class="status-label" data-status-label></span>
    </div>

    <div class="pager-pagination" aria-label="Log navigation">
      <span class="date-indicator" data-status-date></span>
      <div class="button-group">
        <button type="button" class="button" data-control="prev" aria-label="Previous entry" disabled>
          <span class="pager-nav-symbol">‹</span>
        </button>
        <button type="button" class="button" data-control="next" aria-label="Next entry" disabled>
          <span class="pager-nav-symbol">›</span>
        </button>
        <button type="button" class="button" data-control="last" aria-label="Newest entry" disabled>
          <span class="pager-nav-symbol">»</span>
        </button>
      </div>
    </div>
  </div>

  <div class="status-notes" id="status-notes">
    <p></p>
  </div>

  <section class="status-artifacts" id="status-artifacts" hidden></section>
</section>

<script type="application/json" data-status-tag-dates>
{{ (status_tag_dates_json or '[]') | safe }}
</script>
<script src="{{ '/static/status.js' | site_url }}" type="module" async></script>
