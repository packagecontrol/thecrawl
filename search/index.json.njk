---
permalink: "/search/index.json"
---
{% import "packages/macros.njk" as pack %}
[
{% for pkg in collections.minimal_packages -%}
  {
    "name": "{{ pkg.name }}",
    "description": "{{ pkg.description | default('') | nl2br | replace('\n', '') }}",
    "author": "{{ pkg.author | join(', ') }}",
    "stars": "{{ pkg.stars }}",
    "installed": "{{ pkg.installed }}",
    "created_at": "{{ pkg.created_at | timestamp }}",
    "archived_at": "{{ pkg.archived_at | timestamp }}",
    "last_modified": "{{ pkg.last_modified | timestamp }}",
    "removed": "{{ (pkg.removed | timestamp) if pkg.removed }}",
    "doa": "{{ pkg.doa }}",
    "platforms": "{{ pkg.platforms | default([]) | join(",") }}",
    "labels": "{{ pkg.labels | default([]) | join(",") }}",
    "permalink": "/packages/{{ pkg.name | urlencode }}/"
  }{{ "," if not loop.last }}
{%- endfor %}
]
