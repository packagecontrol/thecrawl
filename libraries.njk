---
title: Libraries in Package Control R
layout: layout.njk
date: Last Modified
---

{% macro lib(pkg) %}
  <div class="card">
    <h3>
      <a href="{{ (pkg.releases | first).base }}">
        {{ pkg.name }}
      </a>
    </h3>

    <p>by {% for author in pkg.author -%}
      {{ author }}{{ ", " if not loop.last }}
    {%- endfor %}</p>

    <p>
      {{ pkg.description }}
      <br>
      <img src="{{ 'https://img.shields.io/pypi/v/' ~ pkg.name | replace('python-', '') ~ '.svg' }}">

      {# todo: condition, processing - if url (see h3) is a github repo, add this shield with repo name from the url #}
      <img src="{{ 'https://img.shields.io/github/tag/' ~ pkg.name ~ '.svg' }}">
    </p>

    {% if pkg.platforms | length %}
      <ul class="button-group labels">
        {% for platform in pkg.platforms %}
          <li>
            <span class="button platform platform-{{ platform }}">
              {{ platform }}
            </span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endmacro %}

<h1 data-all="{{ collections.libraries | length }}">
  {{ collections.libraries | length }}
  Libaries
</h1>

<section name="newest">
  <h2>List</h2>
  <ul class="list">
    {% for item in collections.libraries %}
      <li>
        {{ lib(item) }}
      </li>
    {% endfor %}
  </ul>
</section>

