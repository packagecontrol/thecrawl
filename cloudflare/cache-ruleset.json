{
  "name": "default",
  "phase": "http_request_cache_settings",
  "rules": [
    {
      "description": "Bypass package channels",
      "expression": "(http.host eq \"packages.sublimetext.io\" and http.request.uri.path in {\"/channel.json\" \"/channel_st3.json\"})",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": false
      },
      "enabled": true
    },
    {
      "description": "Cache busted static assets",
      "expression": "(http.host eq \"packages.sublimetext.io\" and starts_with(http.request.uri.path, \"/static_\"))",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "respect_strong_etags": true,
        "origin_error_page_passthru": true,
        "serve_stale": {
          "disable_stale_while_updating": false
        }
      },
      "enabled": true
    },
    {
      "description": "Cache package site HTML",
      "expression": "(http.host eq \"packages.sublimetext.io\" and not starts_with(http.request.uri.path, \"/static_\") and http.request.uri.path ne \"/channel.json\" and http.request.uri.path ne \"/channel_st3.json\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 86400
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 60
        },
        "respect_strong_etags": true,
        "origin_error_page_passthru": true,
        "serve_stale": {
          "disable_stale_while_updating": false
        }
      },
      "enabled": true
    }
  ]
}
