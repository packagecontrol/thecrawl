---
layout: layout.njk
permalink: "packages/{{ pkg.name | safe }}.html"
pagination:
  data: collections.packages
  size: 1
  alias: pkg
eleventyComputed:
  title: "{{ pkg.name | safe }}"
  description: "{{ pkg.description | default('') }}"
isPackagePage: true
---

{% import "packages/macros.njk" as pack %}
{% import "packages/install_chart.njk" as charts %}
{% import "util/macros.njk" as util %}

<section name="package" data-list-target="hideme">
  <div class="package-title">
    <h1 id="main-content" tabindex="-1" data-default="{{ pkg.name }}">{{ pkg.name }}</h1>

    {% if not pkg.removed %}
      <button
        class="button clipboard-button"
        data-package-name="{{ pkg.name }}"
        title="Copy install command for Sublime Text to the clipboard"
        aria-label="Copy install command for Sublime Text to the clipboard"
        >
        <span class="icon">{{ util.icon('copy') }}</span>
        <span class="icon check">{{ util.icon('check') }}</span>
      </button>
    {% endif %}
  </div>

  {% if pkg.description %}
    <p class="description">{{ pkg.description }}</p>
  {% endif %}

  {% if pkg.fail_reason and not pkg.removed %}
    {#
      after removal the failed state does not necessarily reflect the reason for removal
      the failure is basically only relevant for packages still in the registry
    #}
    <aside class="warning-message">
      {{ util.icon('warning') }}
      <h2>Updating our information on this package failed:</h2>
      <p>{{ pkg.fail_reason }}</p>
    </aside>
  {% endif %}

  <p>
    By
    {% for author in pkg.author -%}
      {% set q = pack.searchQueryFor('author', author) %}
      <a href="/?q={{ q }}">{{ author }}</a>{{ ", " if not loop.last }}
    {%- endfor %}

    {% if pkg.removed %}
      <br>
      {% if pkg.created_at -%}
        Created <human-date clickable datetime="{{ pkg.created_at }}">{{ pkg.created_at | date_format }}</human-date>,
        removed <human-date clickable datetime="{{ pkg.removed }}">{{ pkg.removed | date_format }}</human-date>.
      {% else %}
        Removed <human-date clickable datetime="{{ pkg.removed }}">{{ pkg.removed | date_format }}</human-date>.
      {%- endif %}

    {% elif pkg.created_at %}
      <br>
      Created <human-date clickable datetime="{{ pkg.created_at }}">{{ pkg.created_at | date_format }}</human-date>
      {%- if pkg.created_at != pkg.last_modified -%}
        , last updated <human-date clickable datetime="{{ pkg.last_modified }}">{{ pkg.last_modified | date_format }}</human-date>
      {%- endif %}{%- if pkg.archived_at -%}
        , archived <human-date clickable datetime="{{ pkg.archived_at }}">{{ pkg.archived_at | date_format }}</human-date>
      {%- endif %}.

    {% elif pkg.last_modified %}
      <br>
      Last updated <human-date clickable datetime="{{ pkg.last_modified }}">{{ pkg.last_modified | date_format }}</human-date>
      {%- if pkg.archived_at -%}
        , archived <human-date clickable datetime="{{ pkg.archived_at }}">{{ pkg.archived_at | date_format }}</human-date>
      {%- endif %}.
    {% endif %}
  </p>

  <div class="chart-container">
    {{ charts.chart(pkg.installed, pkg.weekly_installs, pkg.weekly_removals, pkg.weekly_upgrades, pkg.weekly_dates, pkg.releases) }}
  </div>

  <ul class="stats">
    {{ pack.rip(pkg.removed) }}
    {{ pack.archived(pkg.archived_at) }}
    {{ pack.installs(pkg.installed) }}
    {{ pack.stars(pkg.stars) }}
  </ul>

  {{ pack.labels(pkg.platforms, pkg.labels) }}

  {% if not pkg.removed %}
    {# once a package is removed none of the links or the readme are still reliable #}
    <h2>Links</h2>
    <ul class="button-group links">
      {% if pkg.homepage and not "packagecontrol.io" in pkg.homepage | lower and pkg.details != pkg.homepage %}
      <li>
        <a class="button" href="{{ pkg.homepage }}">{{ util.icon('home') }} <span>Website</span></a>
      </li>
      {% endif %}
      {% if pkg.details %}
      <li>
        <a class="button" href="{{ pkg.details }}">{{ util.icon('repo') }} <span>Repository</span></a>
      </li>
      {% endif %}
      {% if pkg.readme %}
      <li>
        <a class="button" href="{{ pkg.readme_url | default(pkg.readme) }}">{{ util.icon('file') }} <span>README</span></a>
      </li>
      {% endif %}
      {% if pkg.issues %}
        <li>
        <a class="button" href="{{ pkg.issues }}">{{ util.icon('bug') }} <span>Issues</span></a>
      </li>
      {% endif %}
      {% if pkg.donate %}
        <li>
        <a class="button" href="{{ pkg.donate }}">{{ util.icon('gift') }} <span>Donate</span></a>
      </li>
      {% endif %}
    </ul>

    {% include "./_releases.njk" %}
  {% endif %}
</section>

{% if not pkg.removed %}
  <script src="{{ '/static/package.js' | bust }}" type="module" async></script>
{% endif %}

{% if pkg.readme and not pkg.removed %}
  <link rel="stylesheet" href="{{ '/static/style/readme.css' | bust}}">
  <section id="md" class="readme" data-readme-url="{{ pkg.readme }}" data-list-target="hideme"></section>
  <script src="{{ '/static/readme.js' | bust }}" type="module" async></script>
{% endif %}

{% include "search_section.njk" %}
