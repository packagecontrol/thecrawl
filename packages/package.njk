---
layout: layout.njk
permalink: "packages/{{ pkg.name | safe }}/"
pagination:
  data: collections.packages
  size: 1
  alias: pkg
eleventyComputed:
  title: "{{ pkg.name }}"
  description: "{{ pkg.description | default('') }}"
---

{% import "packages/macros.njk" as pack %}

<h1>{{ pkg.name }}</h1>
{% if pkg.description %}
<p class="description">{{ pkg.description }}</p>
{% endif %}

{% if pkg.fail_reason %}
  <aside class="warning-message">
    {{ pack.logo('warning') }}
    <p>{{ pkg.fail_reason }}</p>
  </aside>
{% endif %}

<p>
  By
  {% for author in pkg.author -%}
    {% set q = 'author:"' ~ author ~ '"' %}
    <a href="/?q={{ q | urlencode }}">{{ author }}</a>{{ ", " if not loop.last }}
  {%- endfor %}

  {% if pkg.created_at %}
    <br>
    Since {{ pkg.created_at | date_format }}{% if (pkg.created_at | date_format) != (pkg.last_modified | date_format) -%}
      , last updated {{ pkg.last_modified | date_format }}
    {%- endif %}{% if pkg.removed -%}
      , removed {{ pkg.removed | date_format }}
    {%- elif pkg.archived_at -%}
      , archived {{ pkg.archived_at | date_format }}
    {%- endif %}.

  {% elif pkg.last_modified %}
    <br>
    Last updated {{ pkg.last_modified | date_format }}{% if pkg.removed -%}
      , removed {{ pkg.removed | date_format }}
    {%- elif pkg.archived_at -%}
      , archived {{ pkg.archived_at | date_format }}
    {%- endif %}.
  {% endif %}
</p>

<ul class="stats">
  {{ pack.rip(pkg.removed) }}
  {{ pack.archived(pkg.archived_at) }}
  {{ pack.installs(pkg.installed) }}
  {{ pack.stars(pkg.stars) }}
</ul>

{{ pack.labels(pkg.platforms, pkg.labels) }}

<h2>Links</h2>

<ul class="button-group links">
  {% if not "packagecontrol.io" in pkg.homepage | lower and pkg.details != pkg.homepage %}
  <li>
    <a class="button" href="{{ pkg.homepage }}">{{ pack.logo('home') }} <span>Website</span></a>
  </li>
  {% endif %}
  {% if pkg.details %}
  <li>
    <a class="button" href="{{ pkg.details }}">{{ pack.logo('repo') }} <span>Repository</span></a>
  </li>
  {% endif %}
  {% if pkg.readme %}
  <li>
    <a class="button" href="{{ pkg.readme_url | default(pkg.readme) }}">{{ pack.logo('file') }} <span>README</span></a>
  </li>
  {% endif %}
  {% if pkg.issues %}
    <li>
    <a class="button" href="{{ pkg.issues }}">{{ pack.logo('bug') }} <span>Issues</span></a>
  </li>
  {% endif %}
  {% if pkg.donate %}
    <li>
    <a class="button" href="{{ pkg.donate }}">{{ pack.logo('gift') }} <span>Donate</span></a>
  </li>
  {% endif %}
</ul>

{% if not pkg.removed %}
  {% include "./_releases.njk" %}

  {% if pkg.readme %}
  <section id="md" class="readme" data-readme-url="{{ pkg.readme }}"></section>
  <script src="{{ '/static/readme.js' | bust }}" type="module" async></script>
  {% endif %}
{% endif %}
