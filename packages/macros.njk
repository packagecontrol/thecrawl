{% import "util/macros.njk" as util %}

{% macro labels(platforms, labels) %}
  {% if platforms | length > 0 or  labels | length > 0 %}
    <ul class="button-group labels">
      {% for platform in platforms %}
        {% set q = 'platform:"' ~ platform ~ '"' %}
        <li>
          <a class="button platform platform-{{ platform }}" href="/?q={{ q | urlencode }}">
            {{ platform }}
          </a>
        </li>
      {% endfor %}

      {% for label in labels %}
        {% set q = 'label:"' ~ label ~ '"' %}
        <li>
          <a class="button label" href="/?q={{ q | urlencode }}">
            {{ label }}
          </a>
        </li>
      {%- endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{% macro stars(count, pretty=false) %}
  {% if count > 0 %}
    <li class="stars" title="{{ count }} {{ 'star' if count < 2 else 'stars' }} on GitHub">
      <span aria-hidden="true">{{ util.icon('star') }}</span>
      <span class="counter">{{ (count | compact) if pretty else (count | grouping) }}</span>
      <span class="screenreader-only">stars</span>
    </li>
  {% endif %}
{% endmacro %}

{% macro installs(count, pretty=false) %}
  {% if count > 0 %}
    <li class="installs" title="Installed {{ count }} {{ 'time' if count < 2 else 'times' }}">
      <span aria-hidden="true">{{ util.icon('download') }}</span>
      <span class="counter">{{ (count | compact) if pretty else (count | grouping) }}</span>
      <span class="screenreader-only">installs</span>
    </li>
  {% endif %}
{% endmacro %}

{% macro archived(date) %}
  {% if date %}
    <li class="warning" title="Repository was archived on {{ date | date_format }}">
      <span aria-hidden="true">{{ util.icon('archive') }}</span>
      <span class="counter">Unmaintained</span>
      <span class="screenreader-only">{{ date | date_format }}</span>
    </li>
  {% endif %}
{% endmacro %}

{% macro rip(date) %}
  {% if date %}
    <li class="warning" title="Package was removed on {{ date | date_format }}">
      <span aria-hidden="true">{{ util.icon('archive') }}</span>
      <span class="counter">R.I.P.</span>
      <span class="screenreader-only">{{ date | date_format }}</span>
    </li>
  {% endif %}
{% endmacro %}

{% macro card(pkg) %}
  <div class="card">
    <h3>
      <a href="/packages/{{ pkg.name | urlencode }}/">
        {{ pkg.name }}
      </a>
    </h3>
    <p>by
    {% for author in pkg.author -%}
      {% set q = 'author:"' ~ author ~ '"' %}
      <a href="/?q={{ q | urlencode }}">{{ author }}</a>{{ ", " if not loop.last }}
    {%- endfor %}</p>

    <ul class="stats">
      {{ rip(pkg.removed) }}
      {{ archived(pkg.archived_at) }}
      {{ installs(pkg.installed, true) }}
      {{ stars(pkg.stars, true) }}
    </ul>
    {{ labels(pkg.platforms, pkg.labels) }}
  </div>
{% endmacro %}
