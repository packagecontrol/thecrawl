{% import "_includes/install_chart.njk" as charts %}
{% import "packages/macros.njk" as pack %}

{% if pkg.releases | length > 1 %}
  <h2>Versions</h2>
{% else %}
  <h2>Version</h2>
{% endif %}

<div class="chart-container">
  {{ charts.chart(pkg.weekly_installs, pkg.weekly_removals, pkg.weekly_upgrades, pkg.weekly_dates) }}
</div>
{% for version in pkg.releases %}
  <p>
    {{ pack.release(version) }}
  </p>
{% endfor %}

{% if pkg.otherReleases and pkg.otherReleases | length > 0 %}
<details class="other-releases">
  <summary>Other releases</summary>
  <ul>
    {% for version in pkg.otherReleases %}
      <li>
        {{ pack.release(version) }}
      </li>
    {% endfor %}
  </ul>
</details>
{% endif %}
