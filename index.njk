---
layout: layout.njk
date: Last Modified
---

{% import "packages/macros.njk" as pack %}
{% import "_includes/search_form.njk" as search_ui %}

{{ search_ui.form(true, (collections.packages | length | grouping)) }}

<section name="newest">
  <h2>Newest</h2>
  <ul class="grid">
    {% for pkg in collections.newest_packages %}
      <li>
        {{ pack.card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="recent">
  <h2>Recently updated</h2>
  <ul class="grid">
    {% for pkg in collections.updated_packages %}
      <li>
        {{ pack.card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="result" style="display:none;">
  <h2 id="result-header">Results</h2>
  <ul class="grid"></ul>
</section>

{% include "_includes/enable_search.njk" %}
