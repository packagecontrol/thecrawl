---
layout: layout.njk
date: Last Modified
page_type: home
---

{% import "packages/macros.njk" as pack %}
{% import "util/macros.njk" as util %}

{{ util.form(collections.packages | length, true) }}
{% inline_js 'static/_search_waiter.js' %}

{# Browser massively overscroll anyway but for the search-field we really want
   to show the header and have it more in the middle for the viewport #}
<script>
  if (location.hash === '#search-field') {
    requestAnimationFrame(() => window.scrollTo(0, 0))
  }
</script>

<section name="newest" data-list-target="main-content">
  <h2 class="sticky-section-heading">
    <a href="/?sort=newest" class="section-heading-link">Newest</a>
  </h2>
  <ul class="grid">
    {% for pkg in collections.newest_packages %}
      <li>
        {{ pack.compact_card(pkg, loop.index0 == 0) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="recent" data-list-target="main-content">
  <h2 class="sticky-section-heading">
    <a href="/?sort=update" class="section-heading-link">Recently updated</a>
  </h2>
  <ul class="grid">
    {% for pkg in collections.updated_packages %}
      <li>
        {{ pack.compact_card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="remarkable" data-list-target="main-content" data-remarkable-page="1">
  <div class="remarkable-header">
    <h2 class="sticky-section-heading">Remarkable</h2>
  </div>
  <ul id="remarkable-list" class="remarkable-list">
    {% for pkg in collections.remarkable_packages %}
      <li>
        <span class="remarkable-identity">
          <a class="remarkable-package-name" href="/packages/{{ pkg.name | urlencode }}">{{ pkg.name }}</a>
          {% if pkg.declared_primary_label %}
            {% set q = pack.searchQueryFor('label', pkg.declared_primary_label) %}
            <span class="remarkable-separator" aria-hidden="true">/</span>
            <a class="remarkable-label" href="/?q={{ q }}">{{ pkg.declared_primary_label }}</a>
          {% endif %}
        </span>
        {% if pkg.stars > 0 %}
          <span class="remarkable-stars" title="{{ pkg.stars }} {{ 'star' if pkg.stars == 1 else 'stars' }} on GitHub">
            <span aria-hidden="true">{{ util.icon('star') }}</span>
            <span class="counter">{{ pkg.stars | compact }}</span>
            <span class="screenreader-only">stars</span>
          </span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
{% inline_js 'static/_sticky_section_bootstrap.js' %}
{% inline_js 'static/_recent_waiter.js' %}
<script src="{{ '/static/home.js' | bundled }}" type="module" async></script>

{% include "search_section.njk" %}
