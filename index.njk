---
layout: layout.njk
date: Last Modified
---

{% import "packages/macros.njk" as pack %}
{% import "_includes/search_form.njk" as search_ui %}

<h1 data-default="{{ collections.packages | length }} Packages">
  {{ collections.packages | length }}
  Packages
</h1>
{{ search_ui.form(true) }}

<section name="newest" class="package-list">
  <h2>Newest</h2>
  <ul class="grid">
    {% for pkg in collections.newest_packages %}
      <li>
        {{ pack.card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="recent" class="package-list">
  <h2>Recently updated</h2>
  <ul class="grid">
    {% for pkg in collections.updated_packages %}
      <li>
        {{ pack.card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="result" class="package-list" style="display:none;">
  <h2 id="result-header">Results</h2>
  <ul class="grid"></ul>
</section>

{% include "_includes/enable_search.njk" %}
