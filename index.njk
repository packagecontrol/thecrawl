---
layout: layout.njk
date: Last Modified
---

{% import "packages/macros.njk" as pack %}
{% import "util/macros.njk" as util %}

{{ util.form(collections.packages | length, true) }}

{# Browser massively overscroll anyway but for the search-field we really want
   to show the header and have it more in the middle for the viewport #}
<script>
  if (location.hash === '#search-field') {
    requestAnimationFrame(() => window.scrollTo(0, 0))
  }
</script>

<section name="newest" data-list-target="main-content">
  <h2>
    <a href="/?sort=newest" class="section-heading-link">Newest</a>
  </h2>
  <ul class="grid">
    {% for pkg in collections.newest_packages %}
      <li>
        {{ pack.compact_card(pkg, loop.index0 == 0) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="recent" data-list-target="main-content">
  <h2>
    <a href="/?sort=update" class="section-heading-link">Recently updated</a>
  </h2>
  <ul class="grid">
    {% for pkg in collections.updated_packages %}
      <li>
        {{ pack.compact_card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>
{% inline_js 'static/_recent_waiter.js' %}
<script src="{{ '/static/module/recent-pager.js' | bust }}" type="module" async></script>

{% include "search_section.njk" %}
