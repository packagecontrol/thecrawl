---
layout: layout.njk
title: thecrawl
description: "The nucleus of Sublime's Package Control."
page_type: home
---

<div class="home-status" data-home-status>
  <a class="home-status-link" href="{{ '/status/' | site_url }}">
    <span
      class="home-status-ribbon"
      data-home-status-ribbon
      role="img"
      aria-busy="true"
      aria-label="Crawler status loading"
    ></span>
  </a>
</div>

<section class="home-page" aria-labelledby="fresh-heading">
  <h2 id="fresh-heading">Fresh from the oven,<br>ready to use</h2>

  <div class="artifact-list" aria-label="Latest artifacts">
    <p>
      <a href="{{ '/channel.json' | site_url }}"><code>channel.json</code></a>
      shipping {{ artifact_counts.channelEntries }} packages and libraries
    </p>
    <p>
      <a href="{{ '/registry.json' | site_url }}"><code>registry.json</code></a>
      listing {{ artifact_counts.registryEntries }} live or tombstoned entries
    </p>
  </div>

  <p>Point Package Control at it and use it:</p>
  <pre><code>{
    "channels": [
        "https://packagecontrol.github.io/thecrawl/channel.json"
    ],
    ...
}</code></pre>

  <section class="more-artifacts" aria-label="More artifacts">
    <p>
      More artifacts are available on the
      <a href="https://github.com/packagecontrol/thecrawl/releases">release page</a>.
    </p>
    <p>Download them to your local computer using <code>gh</code>:</p>
    <pre><code>gh -R packagecontrol/thecrawl release download crawler-status [--clobber]</code></pre>
    <p>and build your client and tools around it.</p>
  </section>

  <div class="package-status-prompt">
    <a
      class="package-status-link"
      href="{{ '/status/#status-notes-search' | site_url }}"
    >How's my package doing?</a>
  </div>
</section>

<script src="{{ '/static/home-status.js' | bundled | site_url }}" type="module"></script>
<script src="{{ '/static/theme-switch.js' | bundled | site_url }}" type="module"></script>
