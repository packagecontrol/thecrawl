---
layout: layout.njk
date: Last Modified
---

{% import "packages/macros.njk" as pack %}
{% import "util/macros.njk" as util %}

{{ util.form(true) }}

<section name="newest" data-list-target="hideme">
  <h2>Newest</h2>
  <ul class="grid">
    {% for pkg in collections.newest_packages %}
      <li>
        {{ pack.card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

<section name="recent" data-list-target="hideme">
  <h2>Recently updated</h2>
  <ul class="grid">
    {% for pkg in collections.updated_packages %}
      <li>
        {{ pack.card(pkg) }}
      </li>
    {% endfor %}
  </ul>
</section>

{% include "search_section.njk" %}

<script src="{{ '/static/index.js' | bust }}" type="module" async></script>
