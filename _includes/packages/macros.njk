{% import "util/macros.njk" as util %}

{% macro searchQueryFor(field, raw) -%}
  {%- set value = (raw | default('')) | trim -%}
  {%- if value -%}
    {%- if field == 'platform' and not (' ' in value) -%}
      {{- (field ~ ':' ~ value) | urlencode -}}
    {%- else -%}
      {{- (field ~ ':"' ~ value ~ '"') | urlencode -}}
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}

{% macro release(version, omit_requirements=false) %}
  <a class="download" href="{{ version.download_url or version.url }}" title="Download package">{{ version.version }}</a>

  {% if not omit_requirements %}
    {% set requirement -%}
      {% set requirement_ = version.sublime_text | format_requirement %}
      {% if requirement_ and requirement_ != "*" %}
        <span title="Required ST build">{{ requirement_ }}</span>
      {% endif %}
    {%- endset %}

    {% set pre -%}
      {% set is_prerelease = version.version and '-' in version.version %}
      {% if is_prerelease -%}
        <span title="This is a pre-release">PRE</span>
      {%- endif %}
    {%- endset %}

    {% set parts = [] %}
    {% if pre | trim %}{% set parts = parts.concat([pre]) %}{% endif %}
    {% if requirement | trim %}{% set parts = parts.concat([requirement]) %}{% endif %}
    {% if parts | length > 0 %}
      <span class="requirement">({{ parts | join(', ') | safe | trim }})</span>
    {% endif %}
  {% endif %}

  {% set notes_separator = '·' %}
  {% if version.web %}
    <span class="download-notes-sep">{{ notes_separator }}</span>
    <a class="release" href="{{ version.web }}" title="See release">
      {{ util.icon('note') }}
    </a>
  {% endif %}

  <br>

  <human-date abbreviate-months always-months clickable datetime="{{ version.date }}">{{ version.date | date_time_format }}</human-date>

  {% if version.platforms | length > 0 and not 'any' in version.platforms %}
    — {{ version.platforms | join(', ') }}
  {% endif %}
{% endmacro %}

{% macro labels(pkg, with_icons=false, platform_statement='') %}
  {% set label_buttons -%}
    {%- for label in pkg.labels %}
      {% set q = searchQueryFor('label', label) %}
      <li>
        {% if label == '…' %}
          <a class="button label-more" href="/labels" title="More labels">
            {{ label }}
          </a>
        {% elif label == 'ST2' %}
          <a class="button label state state-bad" href="/?q={{ q }}" title="Outdated package for Sublime Text 2">
            {{ label }}
          </a>
        {% elif label == 'ST3' %}
          <a class="button label state state-warning" href="/?q={{ q }}" title="Compatible with Sublime Text 3 only">
            {{ label }}
          </a>
        {% elif label == 'MIA' %}
          <a class="button label state state-warning" href="/?q={{ q }}" title="Repository was archived on {{ pkg.archived_at | date_format }}">
            {{ label }}
          </a>
        {% elif label == 'FAILING' %}
          <a class="button label state state-failing" href="/?q={{ q }}" title="Package metadata updates are currently failing">
            {{ label }}
          </a>
        {% elif label == 'RIP' %}
          <a class="button label state state-bad" href="/?q={{ q }}" title="Package was removed on {{ pkg.removed | date_format }}">
            {{ label }}
          </a>
        {% else %}
          <a class="button label" href="/?q={{ q }}">
            {% set icon_id = (label | label_icon_id) if with_icons else '' %}
            {% if icon_id %}
              {% set tint = (label | label_icon_tint) if with_icons else '' %}
              <svg class="label-icon{{ (' label-icon--' ~ tint) if tint }}" aria-hidden="true">
                <use href="/{{ 'static/label-icons.svg' | bust }}#{{ icon_id }}"></use>
              </svg>
            {% endif %}
            {{ label }}
          </a>
        {% endif %}
      </li>
    {%- endfor -%}
  {%- endset %}

  {% set buttons -%}
    {%- if platform_statement -%}
      {% set separator_count = (platform_statement | replace('/', '//') | length) - (platform_statement | length) %}
      <li class="platform-statement-wrap{{ ' platform-statement-wrap-enumeration' if separator_count >= 2 }}">
        <span class="button label platform-statement">{{ platform_statement }}</span>
      </li>
      {%- if label_buttons | trim -%}
        <li class="package-labels-wrap">
          <ul class="package-labels">
            {{ label_buttons | safe }}
          </ul>
        </li>
      {%- endif -%}
    {%- else -%}
      {{ label_buttons | safe }}
    {%- endif -%}
  {%- endset %}

  {% if buttons | trim %}
    <ul class="button-group labels">
      {{ buttons | safe }}
    </ul>
  {% endif %}
{% endmacro %}

{% macro platforms(platform_statement) %}
  {% if platform_statement %}
    <li class="platforms">{{ platform_statement }}</li>
  {% endif %}
{% endmacro %}

{% macro stars(count, pretty=false) %}
  {% if count > 0 %}
    <li class="stars" title="{{ count }} {{ 'star' if count < 2 else 'stars' }} on GitHub">
      <span aria-hidden="true">{{ util.icon('star') }}</span>
      <span class="counter">{{ (count | compact) if pretty else (count | grouping) }}</span>
      <span class="screenreader-only">stars</span>
    </li>
  {% endif %}
{% endmacro %}

{% macro installs(count, pretty=false) %}
  {% if count > 0 %}
    <li class="installs" title="Installed {{ count }} {{ 'time' if count < 2 else 'times' }}">
      <span aria-hidden="true">{{ util.icon('download') }}</span>
      <span class="counter">{{ (count | compact) if pretty else (count | grouping) }}</span>
      <span class="screenreader-only">installs</span>
    </li>
  {% endif %}
{% endmacro %}

{% macro compact_card(pkg, mark_as_main=false) %}
  <div class="card card-compact{{ ' dimmed' if pkg.outdated }}">
    <div class="card-heading">
      {{ card_identity(pkg, mark_as_main) }}
    </div>

    <ul class="stats">
      {{ installs(pkg.installed, true) }}
      {{ stars(pkg.stars, true) }}
    </ul>
    {{ labels(pkg, true, pkg.platform_statement) }}
  </div>
{% endmacro %}

{% macro search_result_card(pkg, mark_as_main=false) %}
  <div class="card card-result{{ ' dimmed' if pkg.outdated }}">
    <div class="card-heading">
      <div>
        {{ card_identity(pkg, mark_as_main) }}
      </div>

      <ul class="stats">
        {{ installs(pkg.installed, true) }}
        {{ stars(pkg.stars, true) }}
        {{ platforms(pkg.platform_statement) }}
      </ul>
    </div>

    {% if pkg.description %}
      <p class="description">
        {{ pkg.description }}
      </p>
    {% endif %}

    {{ labels(pkg, true) }}
  </div>
{% endmacro %}

{% macro card_identity(pkg, mark_as_main=false) %}
  <h3>
    <a {{ "id=main-content" if mark_as_main }} href="/packages/{{ pkg.name | urlencode }}">
      {{- pkg.name -}}
    </a>
  </h3>

  {% if pkg.author and (pkg.author | length) > 0 %}
    <p class="authors">by
    {% for author in pkg.author -%}
      {% set q = searchQueryFor('author', author) %}
      <a href="/?q={{ q }}">{{ author }}</a>{{ ", " if not loop.last }}
    {%- endfor %}
    </p>
  {% endif %}
{% endmacro %}
