{% import "util/macros.njk" as util %}

{% macro chart(installed = 0, installs=[], removals=[], upgrades=[], dates=[], releases=[]) %}
  {% set count = installs | length %}
  {# pad chart width to a fixed 53 weeks to avoid width changes #}
  {% set padded_count = (count | at_least(53)) %}
  {% set has_padding = padded_count > count %}

  {# dimensions #}
  {% set dim = {
    bar_w: 12,
    gap: 1,
    upgrade_pt_r: 2,
    release_pt_hit_r: 14,
    top: 14,
    bottom: 42,
    left: 50,
    right: 60,
    chart_h: 160
  } | dimensions(padded_count) %}

  {# compute axes for 5 ticks #}
  {% set l_axis = dim.axis_for(installs, 5) %}
  {% set r_axis = dim.axis_for(upgrades, 5) %}

  <div class="install-chart">
    <svg viewBox="0 0 {{ dim.svg_w }} {{ dim.svg_h }}" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Weekly installs">
      <g transform="translate({{ dim.left }}, {{ dim.top }})">
        {# month change ticks over entire chart #}
        {% for i in range(0, padded_count) %}
          {% set day_offset = dates | monday_at(i) | day_offset_of_month_change %}
          {% if day_offset >= 0 %}
            {% set x = i * (dim.bar_w_gap) %}
            {% set slice_w = dim.slice_width_at(i) %}
            {# weeks are newest→oldest left→right; #}
            {# that means Monday is at *right* ("1 -") edge of slice. #}
            {% set xt = x + (slice_w * (1 - (day_offset / 7))) %}
            {# i + 1 to show the name of the next month #}
            {% set label = dates | monday_at(i + 1) | abbr_month %}
            {% set css_class = (i < count - 1) and 'x-month-label' or 'x-month-label x-month-label-dimmed' %}
            {% set tick_len = 12 %}
            {% if label == 'Dec' %}
              {% set year = dates | monday_at(i + 1) | full_year %}
              {% set dec_label_x = xt + 2 %}
              {% set dec_label_y = dim.chart_h + 12 %}
              {% set dec_anchor = 'start' %}
              {# For December, we draw a multiline with the year and that can collide #}
              {# with the "Weekly Upgrades" label of the y-axis.  Hence we move the #}
              {# Dec label out of its way near the end of a year.  #}
              {# These are manually crafted adjustments. #}
              {% if i == padded_count - 2 %}
                {% set dec_label_x = xt - 12 %}
                {% set dec_anchor = 'start' %}
                {% set tick_len = 6 %}
              {% elseif i == padded_count - 1 %}
                {% set dec_label_x = xt + 4 %}
                {% set dec_anchor = 'end' %}
                {% set tick_len = 6 %}
              {% endif %}
              {{ multiline_text([label, year], dec_label_x, dec_label_y, css_class, dec_anchor) }}
            {% else %}
              {{ text(label, xt + 2, dim.chart_h + 12, css_class) }}
            {% endif %}
            {{ line(xt, dim.chart_h, xt, dim.chart_h + tick_len, 'x-month-tick') }}
          {% endif %}
        {% endfor %}

        {# bars + week overlays #}
        {% for inst in installs %}
          {% set i = loop.index0 %}
          {% set rem = removals[i] %}
          {% set up = upgrades[i] %}
          {% set net_val = ((inst - rem) | at_least(0)) %}
          {% set rem_draw = (rem | at_most(inst)) %}
          {% set net_h  = l_axis.to_px(net_val) %}
          {% set rem_h  = l_axis.to_px(rem_draw) %}

          {% set x = i * (dim.bar_w_gap) %}
          {% set y_top_inst = l_axis.y_for(inst) %}
          {% set y_net      = l_axis.y_for(net_val) %}
          {% set y_rem      = y_net - rem_h %}
          {% set slice_w = dim.slice_width_at(i) %}

          {% set title_parts = [
            dates[i],
            'installs: ' ~ (inst | grouping),
            'removals: ' ~ (rem | grouping),
            'upgrades: ' ~ (up | grouping)
          ] %}
          {% set title_text = title_parts | join(' | ') %}

          <g class="week" data-week="{{ i }}">
            {# subtle hover background spanning the full slice #}
            {{ rect(x, 0, slice_w, dim.chart_h, 'week-slice-bg') }}

            {# grid line #}
            {{ draw_grid_lines(i, x, slice_w, dim, l_axis) }}

            {# the actual bars #}
            {{ rect(x, y_net, dim.bar_w, net_h, 'bar bar-net', title_text) }}
            {{ rect(x, y_rem, dim.bar_w, rem_h, 'bar bar-remove', title_text) }}
            {# Distinguish no-activity weeks from removal-only weeks without rescaling the chart. #}
            {% if inst == 0 and rem > 0 %}
              {{ rect(x, dim.chart_h, dim.bar_w, 3, 'bar bar-remove bar-remove-excess', title_text) }}
            {% endif %}

            {# third bar: invisible hit area from top to top of installs just for the tooltip #}
            {{ rect(x, 0, dim.bar_w, y_top_inst, 'week-slice-hit', title_text) }}

          </g>
        {% endfor %}

        {# render empty week slices to fill padded area width a grid #}
        {% for i in range(count, padded_count) %}
          {% set x = i * (dim.bar_w_gap) %}
          {% set slice_w = dim.slice_width_at(i) %}
          <g class="week" data-week="{{ i }}">
            {{ draw_grid_lines(i, x, slice_w, dim, l_axis) }}
          </g>
        {% endfor %}

        {# average lines (exclude running week at index 0)
           - installs: mean(installs[i]) for i >= 1
           - net installs: mean(max(installs[i] - removals[i], 0)) for i >= 1
        #}
        {% set count_excl0 = count - 1 %}
        {% if count_excl0 > 0 %}
          {% set sum_inst = (installs | slice(1) | sum) %}
          {% set sum_rem  = (removals | slice(1) | sum) %}
          {% set sum_net  = ((sum_inst - sum_rem) | at_least(0)) %}
          {% set avg_inst = (sum_inst / count_excl0) %}
          {% set avg_net  = (sum_net  / count_excl0) %}
          {% set y_avg_inst = l_axis.y_for(avg_inst) %}
          {% set y_avg_net = l_axis.y_for(avg_net) %}
          {{ line(0, y_avg_inst, dim.chart_w, y_avg_inst, 'avg-line avg-line-inst') }}
          {{ line(0, y_avg_net,  dim.chart_w, y_avg_net,  'avg-line avg-line-net') }}
        {% endif %}

        {# upgrades overlay #}
        {# Only show upgrades line and points when there is at least one upgrade #}
        {% if (upgrades | sum) > 0 %}
          {#
            upgrades line path (smoothed cubic Bézier via Catmull–Rom approximation)

            Basics:
            - A straight polyline would use SVG 'L' commands between points: M x0 y0 L x1 y1 L x2 y2 …
              That produces sharp corners. To smooth the line we switch to cubic Bézier segments ('C').
              We start with a first point (M), and then continue with two control points and a segment
              end-point (C).
              Refer: https://svg-tutorial.com/editor/cubic-bezier

            - For each curved segment from P1 to P2 we take four points P0, P1, P2, P3
              (clamping at the ends) and compute the two control points as:
                C1 = P1 + (P2 − P0) / 6
                C2 = P2 − (P3 − P1) / 6
              This is a common Catmull–Rom to Bézier conversion that yields a smooth line
              passing through all data points.
          #}
          {% set d = '' %}
          {% if count > 1 %}
            {# draw solid line from first full week onwards #}
            {% set val1 = upgrades[1] %}
            {% set y_start = r_axis.y_for(val1) %}
            {% set x_start = 1 * (dim.bar_w_gap) + (dim.bar_w / 2) %}
            {#               ^ shift one bar to the right #}
            {% set d = 'M ' ~ x_start ~ ' ' ~ y_start %}

            {# build cubic segments, starting at i=1 to skip 0→1 #}
            {% for i in range(1, count - 1) %}
              {# indices p0, p1, p2, p3 (clamped) #}
              {% set i0 = ((i - 1) | at_least(1)) %}
              {% set i1 = i %}
              {% set i2 = i + 1 %}
              {% set i3 = ((i + 2) | at_most(count - 1)) %}

              {% set v0 = upgrades[i0] %}
              {% set v1 = upgrades[i1] %}
              {% set v2 = upgrades[i2] %}
              {% set v3 = upgrades[i3] %}

              {% set x0 = i0 * (dim.bar_w_gap) + (dim.bar_w / 2) %}
              {% set x1 = i1 * (dim.bar_w_gap) + (dim.bar_w / 2) %}
              {% set x2 = i2 * (dim.bar_w_gap) + (dim.bar_w / 2) %}
              {% set x3 = i3 * (dim.bar_w_gap) + (dim.bar_w / 2) %}

              {% set y0 = r_axis.y_for(v0) %}
              {% set y1 = r_axis.y_for(v1) %}
              {% set y2 = r_axis.y_for(v2) %}
              {% set y3 = r_axis.y_for(v3) %}

              {#
                Catmull–Rom → Bézier control points
                Intuition: Catmull–Rom defines the tangent at P1 as (P2−P0)/2 and at P2 as (P3−P1)/2
                (with unit spacing). A cubic Bézier's tangents are 3·(C1−P1) at the start and
                3·(P2−C2) at the end. T.i.:
                  3·(C1−P1) = (P2−P0)/2
                     C1−P1  = (P2−P0)/6
                         C1 = P1 + (P2−P0)/6
                Likewise:
                  3·(P2−C2) = (P3−P1)/2
                         C2 = P2 − (P3−P1)/6
              #}
              {% set c1x = x1 + (x2 - x0) / 6 %}
              {% set c1y = y1 + (y2 - y0) / 6 %}
              {% set c2x = x2 - (x3 - x1) / 6 %}
              {% set c2y = y2 - (y3 - y1) / 6 %}

              {% set d = d ~ ' C ' ~ c1x ~ ' ' ~ c1y ~ ' ' ~ c2x ~ ' ' ~ c2y ~ ' ' ~ x2 ~ ' ' ~ y2 %}
            {% endfor %}
          {% endif %}
          <path d="{{ d }}" class="upgrades-line" />
          {% if count > 1 %}
            {% set x_week0 = dim.bar_w / 2 %}
            {% set y_week0 = r_axis.y_for(upgrades[0]) %}
            {% set x_week1 = 1 * (dim.bar_w_gap) + (dim.bar_w / 2) %}
            {% set y_week1 = r_axis.y_for(upgrades[1]) %}
            {{ line(x_week0, y_week0, x_week1, y_week1, 'upgrades-line upgrades-line-dashed') }}
          {% endif %}

          {# Points with tooltips #}
          {% for val in upgrades %}
            {% set i = loop.index0 %}
            {% set y2 = r_axis.y_for(val) %}
            {% set x2 = i * (dim.bar_w_gap) + (dim.bar_w / 2) %}
            {# Visible point without title #}
            <circle cx="{{ x2 }}" cy="{{ y2 }}" r="{{ dim.upgrade_pt_r }}" class="upgrades-point" />
          {% endfor %}
        {% endif %}

        {# left and right axis with its tick labels and multi-line legend #}
        {{ draw_axis_with_labels(l_axis, 0, dim, 'tick') }}
        {{ multiline_text(['Weekly', 'Installs'], -6, dim.chart_h + 24, anchor='end') }}

        <g class="upgrades-axis">
          {{ draw_axis_with_labels(r_axis, dim.chart_w, dim, 'tick tick-right', 'start') }}
          {{ multiline_text(['Weekly', 'Upgrades'], dim.chart_w + 6, dim.chart_h + 24) }}
        </g>

        {# x-axis #}
        {{ line(0, dim.chart_h, dim.chart_w, dim.chart_h, 'axis') }}

        {# release dots and callouts #}
        {% set release_weeks = releases | release_week_model(dates, padded_count) %}
        {% if release_weeks and (release_weeks | length) > 0 %}
          <style>
            {#
              Release callout interaction model (CSS-only)
              ============================================

              A .release-week or .release-week[data-week="N"] groups a red .release-point,
              the hit area of that point (.release-point-hit), and the .release-callout-group.

                - .release-point             : visible point on upgrades line
                - .release-point-hit         : large transparent hit target
                - .release-callout-group     : vertical callout + version label

              Base visibility rules:
              - Latest release has .is-default and starts visible.
              - All other release callouts start hidden.

            #}
            .install-chart {
              {# every release callout starts hidden #}
              .release-week .release-callout-group {
                opacity: 0;
                pointer-events: none;
                transition: opacity .3s ease-out;
              }
              .release-week .release-label-expanded {
                display: none;
              }
              .release-week:has(.release-point-hit:hover) .release-label-collapsed {
                display: none;
              }
              .release-week:has(.release-point-hit:hover) .release-label-expanded {
                display: inline;
              }
              {# except the leading release (.is-default), which starts visible #}
              .release-week.is-default .release-callout-group {
                opacity: 1;
                transition-duration: .1s;
              }
              {# when hovering a release hit-target, #}
              .release-week:has(.release-point-hit:hover) {
              {# show its release callout #}
                .release-callout-group {
                  opacity: 1;
                  transition-duration: .1s;
                }
              {# and promote its release point #}
                .release-point {
                  stroke-width: 1px;
                  stroke: var(--release-point-stroke-color);
                }
              {# "void" release points are faded by default so make them fully visible too #}
                .release-point-in-the-void {
                  opacity: 1;
                }
              }
              {# while any release is hovered, demote the default release point #}
              &:has(.release-point-hit:hover) .release-week.is-default .release-point {
                stroke-width: 0.3px;
                stroke: var(--release-point-stroke-alt-color);
              }
              {# unless the hovered release is itself the default release #}
              .release-week.is-default:has(.release-point-hit:hover) .release-point {
                stroke-width: 1px;
                stroke: var(--release-point-stroke-color);
              }
              {# while any release is hovered, hide the default callout #}
              &:has(.release-point-hit:hover) .release-week.is-default .release-callout-group {
                opacity: 0;
              }
              {# unless the hovered release is itself the default release #}
              .release-week.is-default:has(.release-point-hit:hover) .release-callout-group {
                opacity: 1;
                transition-duration: .1s;
              }
              {# hovering upgrades axis OR any release point thickens upgrades line/points #}
              &:has(.upgrades-axis:hover),
              &:has(.release-point-hit:hover) {
                .upgrades-line {
                  stroke-width: 2.8px;
                }
                .upgrades-point {
                  stroke-width: 0.2px;
                  transition: .5s opacity;
                }
              }
            }
            {% set release_nearest = release_weeks | release_week_nearest_map(padded_count) %}
            {% set default_week_idx = release_weeks[0].week_idx %}
            {% for week_idx in range(0, padded_count) %}
              {% set nearest_week_idx = release_nearest[week_idx] %}
              {% if nearest_week_idx is not none %}
                {# hovering a specific week ({{ week_idx }}) #}
                .install-chart:has(.week[data-week="{{ week_idx }}"]:hover) {
                  {# promotes the nearest release week {{ nearest_week_idx }} #}
                  .release-week[data-week="{{ nearest_week_idx }}"] {
                    .release-callout-group {
                      opacity: 1;
                      transition-duration: .1s;
                    }
                    .release-point {
                      stroke-width: 1px;
                      stroke: var(--release-point-stroke-color);
                    }
                    .release-point-in-the-void {
                      opacity: 1;
                    }
                  }
                  {# if nearest release is not default, #}
                  {% if nearest_week_idx != default_week_idx %}
                    .release-week.is-default {
                    {# hide the default callout #}
                      .release-callout-group { opacity: 0; }
                    {# and demote the release point #}
                      .release-point {
                        stroke-width: 0.3px;
                        stroke: var(--release-point-stroke-alt-color);
                      }
                    }
                  {% endif %}
                }
              {% endif %}
            {% endfor %}
            {% for i in range(0, release_weeks | length) %}
              {% set week_idx = release_weeks[i].week_idx %}
              {# hovering a release week {{ week_idx }} also highlights its install bar #}
              .install-chart:has(.release-week[data-week="{{ week_idx }}"] .release-point-hit:hover) {
                .week[data-week="{{ week_idx }}"] .bar {
                  fill: var(--install-bar-hover-color);
                }
              }
            {% endfor %}
          </style>

          {% set default_y = y_avg_net | default(l_axis.y_for(0), true) %}
          {% set release_coords = release_weeks | release_week_coords(upgrades, dim, r_axis, default_y) %}
          {% for i in range(0, release_weeks | length) %}
            {% set release = release_weeks[i] %}
            {% set is_latest_release = i == 0 %}
            {% set r_coord = release_coords[i] %}
            {% set release_has_stats = r_coord.has_stats %}

            {% set release_title = dates[release.week_idx] %}
            {% if release_has_stats %}
              {% set release_val = upgrades[release.week_idx] | default(0, true) %}
              {% set release_title = release_title ~ ' | upgrades: ' ~ (release_val | grouping) %}
            {% endif %}

            {% set release_week_class = 'release-week' %}
            {% if is_latest_release %}
              {% set release_week_class = release_week_class ~ ' is-default' %}
            {% endif %}
            <g class="{{ release_week_class }}" data-week="{{ release.week_idx }}">
              {# Simple hit circle for release tooltip #}
              <circle
                cx="{{ r_coord.x }}"
                cy="{{ r_coord.y }}"
                r="{{ dim.release_pt_hit_r }}"
                class="release-point-hit">
                <title>{{ release_title }}</title>
              </circle>

              {# Visible release point without title #}
              {% set release_point_classes = 'upgrades-point release-point' %}
              {% if not release_has_stats %}
                {% set release_point_classes = release_point_classes ~ ' release-point-in-the-void' %}
              {% endif %}
              <circle cx="{{ r_coord.x }}" cy="{{ r_coord.y }}" r="{{ dim.upgrade_pt_r }}" class="{{ release_point_classes }}" />

              <g class="release-callout-group">
                {% set gap_to_line_start = 4 %}
                {% set gap_to_text = 4 %}
                {% set minimum_line_length = 12 %}
                {% set max_line_length = 52 %}
                {% set void_line_length = 24 %}  {# the default line length when we have a version and no stats around it #}

                {# callout line heading North #}
                {% set line_start_y = (r_coord.y - dim.upgrade_pt_r - gap_to_line_start) | at_least(0) %}
                {# Watch out +- 4 weeks and compute `line_end_y` to stay visually above everything else #}
                {% set look_start = (release.week_idx - 4) | at_least(0) %}
                {% set look_end = (release.week_idx + 4) | at_most(padded_count - 1) %}
                {% set max_upgrade_val = upgrades | slice(look_start, look_end + 1) | max %}
                {% set max_install_val = installs | slice(look_start, look_end + 1) | max %}

                {% if max_upgrade_val == 0 and max_install_val == 0 %}  {# no stats around #}
                  {% set line_end_y = (line_start_y - void_line_length) | at_least(0) %}
                {% else %}
                  {% set upgrade_top = r_axis.y_for(max_upgrade_val) - dim.upgrade_pt_r - gap_to_line_start %}
                  {% set install_top = l_axis.y_for(max_install_val) - gap_to_line_start %}
                  {% set y_points = [line_start_y - minimum_line_length, upgrade_top, install_top] %}
                  {% set line_end_y = y_points | min | at_least(0) %}
                {% endif %}

                {% set line_length = line_start_y - line_end_y %}
                {% set clipped = line_length > max_line_length %}
                {% if clipped %}
                  {% set line_start_y = (line_end_y + max_line_length) | at_most(line_start_y) %}
                {% endif %}

                <line x1="{{ r_coord.x }}" y1="{{ line_start_y }}" x2="{{ r_coord.x }}" y2="{{ line_end_y }}" class="release-callout" />
                {% if clipped %}
                  {{ draw_arrow(r_coord.x, line_start_y, 3, 2) }}
                {% endif %}

                {# If line_start_y == 0 we draw a point at the top edge with no callout line #}
                {# but just the text.  Increase the gap_to_text slightly by 2 in that case. #}
                {% set label_y = line_end_y - gap_to_text - (line_start_y == 0 and 2 or 0) %}
                {{ draw_callout_label(release.versions, r_coord.x, label_y, dim.chart_w) }}
              </g>
            </g>
          {% endfor %}
        {% endif %}
      </g>
    </svg>
  </div>

  <div class="legend">
    <div class="color color-gross"></div>
    Installations:
    {%- if avg_inst %}
      recent average {{ avg_inst | round | grouping }} per week,
    {%- endif %}
    {{ installed | grouping }} in total
    <br>
    <div class="color color-net"></div>
    Installations minus removals
    <br>
    <div class="color color-upgrade"></div>
    Upgrades
  </div>

{% endmacro %}

{% macro draw_axis_with_labels(axis, x_pos, dim, css_class='tick', text_anchor='end', offset=6) %}
  {% set sign = (text_anchor == 'end') and -1 or 1 %}
  {{ line(x_pos, 0, x_pos, dim.chart_h, 'axis') }}
  {% for step in axis.steps | every_other %}
    {% set y = axis.y_for(step) %}
    {{ text(step | compact, x_pos + (sign * offset), y, css_class, text_anchor) }}
  {% endfor %}
{% endmacro %}

{% macro draw_grid_lines(i, x, slice_w, dim, axis) %}
  <clipPath id="clip-week-{{ i }}">
    {{ rect(x, 0, slice_w, dim.chart_h) }}
  </clipPath>
  <g clip-path="url(#clip-week-{{ i }})">
    {% for step in axis.steps %}
      {% set gy = axis.y_for(step) %}
      {{ line(0, gy, dim.chart_w, gy, 'grid') }}
    {% endfor %}
  </g>
{% endmacro %}

{% macro rect(x, y, w, h, class='', title='') %}
  <rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" class="{{ class }}">
    {% if title %}<title>{{ title }}</title>{% endif %}
  </rect>
{% endmacro %}

{% macro line(x1, y1, x2, y2, class='') %}
  <line x1="{{ x1 }}" y1="{{ y1 }}" x2="{{ x2 }}" y2="{{ y2 }}" class="{{ class }}" />
{% endmacro %}

{% macro draw_arrow(x, y, height, side_width, class='release-callout') %}
  {% set base_y = y - height %}
  <polygon points="{{ x }},{{ y }} {{ x - side_width }},{{ base_y }} {{ x + side_width }},{{ base_y }}" class="{{ class }}" />
{% endmacro %}

{% macro draw_callout_label(
  versions, base_x, label_y, chart_w,
  margin=4,
  char_width=6,
  class='release-label')
%}
  {% set count = versions | length %}
  {% set compact_label = versions[0] | default('', true) %}
  {% if count == 2 %}
    {% set compact_label = versions[0] ~ ' / ' ~ versions[1] %}
  {% elseif count > 2 %}
    {% set compact_label = versions[0] ~ ' / ' ~ versions[1] ~ ' / ...' %}
  {% endif %}

  {% set full_label = versions | join(' / ') %}

  {% set max_len = compact_label | length %}
  {% set half_width = (max_len * char_width) / 2 %}
  {% set x_left = base_x - half_width %}
  {% set x_right = base_x + half_width %}
  {% set chart_right = chart_w - margin %}
  {% if x_left < margin %}
    {% set anchor = 'start' %}
    {% set label_x = margin %}
  {% elseif x_right > chart_right %}
    {% set anchor = 'end' %}
    {% set label_x = chart_right %}
  {% else %}
    {% set anchor = 'middle' %}
    {% set label_x = base_x %}
  {% endif %}

  {% if count > 2 %}
    {% set expanded_len = full_label | length %}
    {% set expanded_half_width = (expanded_len * char_width) / 2 %}
    {% set expanded_left = base_x - expanded_half_width %}
    {% set expanded_right = base_x + expanded_half_width %}
    {% if expanded_left < margin %}
      {% set expanded_anchor = 'start' %}
      {% set expanded_x = margin %}
    {% elseif expanded_right > chart_right %}
      {% set expanded_anchor = 'end' %}
      {% set expanded_x = chart_right %}
    {% else %}
      {% set expanded_anchor = 'middle' %}
      {% set expanded_x = base_x %}
    {% endif %}

    {{ text(compact_label, label_x, label_y, class ~ ' release-label-collapsed', anchor, 'alphabetic') }}
    {{ text(full_label, expanded_x, label_y, class ~ ' release-label-expanded', expanded_anchor, 'alphabetic') }}
  {% else %}
    {{ text(compact_label, label_x, label_y, class, anchor, 'alphabetic') }}
  {% endif %}
{% endmacro %}

{% macro text(t, x, y, class='', anchor='start', baseline='middle') %}
  <text x="{{ x }}" y="{{ y }}" text-anchor="{{ anchor }}" dominant-baseline="{{ baseline }}" class="{{ class }}">{{ t }}</text>
{% endmacro %}

{% macro multiline_text(lines, x, y, class='', anchor='start', line_height=12) %}
  {% set cls = class or ((anchor == 'end') and 'tick' or 'tick tick-right') %}
  <g class="tick-label" transform="translate({{ x }}, {{ y }})">
    {% for t in lines %}
      {{ text(t, 0, loop.index0 * line_height, cls, anchor) }}
    {% endfor %}
  </g>
{% endmacro %}
