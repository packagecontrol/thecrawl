{% import "util/macros.njk" as util %}

<header>
  <a href="#search-field" class="skip-link">Skip to search</a>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <a href="#footer-links" class="skip-link">Skip to footer links</a>

  <div class="left-side">
    {% set tag = 'h1' if page.url == '/' else 'p' %}
    <{{ tag }} class="brand">
      <a href="/">
        Package Control <span class="hot">R</span>
      </a>
    </{{ tag }}>

    <p class="tagline">The Sublime Text package directory, {{ [
        "re-imagined",
        "reassembled",
        "rebooted",
        "reborn",
        "recompiled",
        "refactored",
        "reinvigorated",
        "remastered",
        "replenished",
        "restarted",
        "resurrected",
        "revisited",
        "rewired"
      ] | random
    }}.</p>
  </div>

  <div class="right-side">
    {% if isPackagePage %}
      {{ util.form(collections.packages | length, false) }}
    {% endif %}

    <nav>
      {% if isPackagePage %}
        <a class="search-toggle" href="/#search-field">
          {{ util.icon('search') }}
          <span class="screenreader-only">Search</span>
        </a>
      {% endif %}

      <button id="theme-toggle" aria-label="Toggle color scheme">
        <div class="icon">
          <span class="light" aria-label="light">{{ util.icon('sun') }}</span>
          <span class="dark" aria-label="dark">{{ util.icon('moon') }}</span>
        </div>
      </button>

      {% if site.origin != site.prodOrigin and not site.disableLiveLink %}
        {% set liveHref = site.prodOrigin + (page.url or '/') %}
        <a href="{{ liveHref }}" aria-label="View this page on the live site" style="margin: 0 0.5em;" data-live-site-link>L</a>
        {# The search and possible hash state in the URL must be inspected live using JS: #}
        <script>
          (() => {
            const link = document.querySelector('[data-live-site-link]')
            if (!link) {
              return
            }
            const prodOrigin = '{{ site.prodOrigin }}'
            const updateHref = (anchor) => {
              const { pathname, search, hash } = window.location
              anchor.href = prodOrigin + pathname + search + hash
            }
            const handler = (event) => updateHref(event.currentTarget)
            link.addEventListener('click', handler)
            link.addEventListener('auxclick', handler)
            link.addEventListener('mouseenter', handler)
            link.addEventListener('focus', handler)
          })()
        </script>
      {% endif %}
    </nav>
  </div>

</header>
