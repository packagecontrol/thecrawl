{% import "packages/macros.njk" as pack %}
{% import "_includes/search_form.njk" as search_ui %}

<header>
  <div class="inner">

    <div class="left-side">
      <p class="brand"><a href="/">Package Control <span class="hot">R</span></a></p>
      <p>The Sublime Text package directory, {{ [
          "re-imagined",
          "reassembled",
          "rebooted",
          "reborn",
          "recompiled",
          "refactored",
          "reinvigorated",
          "remastered",
          "replenished",
          "restarted",
          "resurrected",
          "revisited",
          "rewired"
        ] | random
      }}.</p>
    </div>

    <div class="right-side">
      {% if isPackagePage %}
        {{ search_ui.form(false) }}
      {% endif %}

      <nav>
        {% if isPackagePage %}
          <a href="/#search-field">
            {{ pack.logo('search') }}
            <span class="screenreader-only">Search</span>
          </a>
        {% endif %}

        <a href="/about">About / FAQ</a>
      </nav>
    </div>

  </div>

</header>
