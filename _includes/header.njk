{% import "util/macros.njk" as util %}

<header>

  <div class="left-side">
    {% if page.url == '/' %}
      <h1 class="brand">
        Package Control <span class="hot">R</span>
      </h1>
    {% else %}
      <p class="brand">
        <a href="/">
          Package Control <span class="hot">R</span>
        </a>
      </p>
    {% endif %}

    <p class="tagline">The Sublime Text package directory, {{ [
        "re-imagined",
        "reassembled",
        "rebooted",
        "reborn",
        "recompiled",
        "refactored",
        "reinvigorated",
        "remastered",
        "replenished",
        "restarted",
        "resurrected",
        "revisited",
        "rewired"
      ] | random
    }}.</p>
  </div>

  <div class="right-side">
    {% if isPackagePage %}
      {{ util.form(false) }}
    {% endif %}

    <nav>
      {% if isPackagePage %}
        <a href="/#search-field">
          {{ util.icon('search') }}
          <span class="screenreader-only">Search</span>
        </a>
      {% endif %}

      <a href="/about">About</a>
    </nav>
  </div>

</header>
