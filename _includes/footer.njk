<footer class="site-footer">
  <a class="footer-brand" href="{{ '/' | site_url }}" aria-label="thecrawl home">
    <img src="{{ '/static/assets/thecrawl.svg' | static_url }}" alt="thecrawl.">
  </a>
  <p>
    The nucleus of Sublime's Package Control.<br>
    Dates and times are in your local time.<br>
    &copy; {{ built.year }}
    <span class="footer-built" data-footer-built>
      · Built <time datetime="{{ built.iso }}" data-footer-built-time>{{ built.formatted }}</time>
    </span>
  </p>
  <nav aria-label="Footer">
    <a href="https://github.com/packagecontrol/thecrawl">GitHub</a>
    <a href="https://github.com/packagecontrol/thecrawl/releases">Artifacts</a>
    <a href="{{ '/status/' | site_url }}">Status</a>
    {% if page_type == 'home' %}
      <button
        class="theme-switch"
        type="button"
        data-theme-switch
        data-mode="auto"
        aria-label="Switch light/dark mode"
        title="Switch light/dark mode"
      >
        <span class="theme-switch-scene" aria-hidden="true">
          <span class="theme-switch-cylinder">
            <svg class="theme-switch-icon theme-switch-sun" viewBox="0 0 16 16" width="16" height="16">
              <path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.06-1.06a.75.75 0 0 1 1.06 0Zm-9.193 9.193a.75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3 8a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 3 8Zm13 0a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8Zm-8 5a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13Zm3.536-1.464a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.06-1.06a.75.75 0 0 1 0-1.06Z"></path>
            </svg>
            <svg class="theme-switch-icon theme-switch-moon" viewBox="0 0 16 16" width="16" height="16">
              <path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z"></path>
            </svg>
          </span>
        </span>
        <span class="theme-switch-label" data-theme-switch-label>Auto</span>
      </button>
    {% endif %}
  </nav>
  <script>
    (() => {
      const footer = document.currentScript.closest('.site-footer')
      const built = footer?.querySelector('[data-footer-built]')
      const time = footer?.querySelector('[data-footer-built-time]')
      const date = new Date(time?.dateTime || '')
      if (!built || !time || !Number.isFinite(date.getTime())) return

      time.textContent = formatLocalTimestamp(date)
      requestAnimationFrame(() => built.classList.add('is-visible'))

      function formatLocalTimestamp(value) {
        const datePart = [
          value.getFullYear(),
          pad(value.getMonth() + 1),
          pad(value.getDate()),
        ].join('-')
        const timePart = `${pad(value.getHours())}:${pad(value.getMinutes())}`
        return `${datePart} ${timePart} ${formatTimezoneOffset(value)}`
      }

      function formatTimezoneOffset(value) {
        const offset = -value.getTimezoneOffset()
        const sign = offset >= 0 ? '+' : '-'
        const absolute = Math.abs(offset)
        const hours = Math.floor(absolute / 60)
        const minutes = absolute % 60
        return `GMT${sign}${hours}${minutes ? `:${pad(minutes)}` : ''}`
      }

      function pad(value) {
        return String(value).padStart(2, '0')
      }
    })()
  </script>
</footer>
