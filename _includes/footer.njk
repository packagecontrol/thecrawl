{% import "util/macros.njk" as util %}

<footer>
  <img src="/assets/logo.webp" width="80" height="80" alt="Package Control R logo">
  <h2>Package Control</h2>

  <p>
    Package Control is the community-driven package management solution
    for <a href="https://www.sublimetext.com/">Sublime Text</a>.
    <br>
    Dates and times are in local time.
    <br>
    &copy; {{ built.year }} — Built: <human-date raw datetime="{{ built.timestamp }}">{{ built.formatted }}</human-date>
  </p>

  <nav>
    <a id="footer-links" href="https://docs.sublimetext.io/guide/package-control/submitting.html">Submit your package</a>
    <a href="https://docs.sublimetext.io/guide/package-control/usage.html">Using package control</a>
    {% if page.url == "/libraries/" %}
      <a href="/">Packages</a>
    {% else %}
      <a href="/libraries">Libraries</a>
    {% endif %}
    {% if page.url == "/labels/" %}
      <a href="/">Packages</a>
    {% else %}
      <a href="/labels">Labels</a>
    {% endif %}
    <a href="https://github.com/packagecontrol/thecrawl/tree/gh-pages">This website on GitHub</a>
  </nav>

  <button id="theme-toggle" aria-label="Toggle color scheme">
    <div class="icon">
      <span class="light" aria-label="light">{{ util.icon('sun') }}</span>
      <span class="dark" aria-label="dark">{{ util.icon('moon') }}</span>
    </div>
  </button>
</footer>
