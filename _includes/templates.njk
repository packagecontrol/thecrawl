{% import "packages/macros.njk" as pack %}
{% import "util/macros.njk" as util %}

{# template used by JS to render cards #}
<template id="package-card">
  {{ pack.card({
    "name": "placeholder-name",
    "description": "placeholder-description",
    "author": "placeholder-author",
    "stars": 666,
    "installed": 999,
    "archived_at": "1970-01-01 00:00:00",
    "platforms": ["foo"],
    "labels": ["foo"],
    "permalink": "placeholder-permalink"
  }) }}
</template>

<template id="clipboard-button">
  <button class="button clipboard-button" title="Copy to clipboard" aria-label="Copy to clipboard">
    <span class="icon">{{ util.icon('copy') }}</span>
    <span class="icon check">{{ util.icon('check') }}</span>
  </button>
</template>

<template id="inline-message">
  <div class="message inline-message" role="status" aria-live="polite" aria-hidden="true"></div>
</template>
