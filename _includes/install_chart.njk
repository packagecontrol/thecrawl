{% macro chart(installs=[], removals=[], upgrades=[], dates=[]) %}
  {% set count = installs | length %}
  {% if count > 0 %}

  {# dimensions #}
  {% set bar_w = 12 %}
  {% set gap = 1 %}
  {% set upgrade_pt_r = 2.5 %}
  {% set top = 10 %}
  {% set bottom = 20 %}
  {% set left = 40 %}
  {% set right = 44 %}
  {% set chart_h = 120 %}
  {# Pad chart width to a fixed 53 weeks to avoid width changes #}
  {% set padded_count = (count | at_least(53)) %}
  {% set chart_w = (padded_count * (bar_w + gap)) - gap %}
  {% set svg_w = left + chart_w + right %}
  {% set svg_h = top + chart_h + bottom %}

  {# compute left-axis for 5 ticks #}
  {% set target = 5 %}
  {% set step = (installs | compute_step(target)) %}
  {% set max_scale = step * target %}

  {# compute right-axis for upgrades #}
  {% set target_r = 5 %}
  {% set step_r = (upgrades | compute_step(target_r)) %}
  {% set max_scale_r = step_r * target_r %}

  <div class="install-chart">
    <svg viewBox="0 0 {{ svg_w }} {{ svg_h }}" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Weekly installs">
      <g transform="translate({{ left }}, {{ top }})">
        {# left axis and tick labels #}
        <line x1="0" y1="0" x2="0" y2="{{ chart_h }}" class="axis" />
        {% for i in range(0, target + 1) %}
          {% set t = i * step %}
          {% set y = chart_h - (t / max_scale) * chart_h %}
          {% if (i % 2) == 0 %}
            <text x="-6" y="{{ y }}" text-anchor="end" dominant-baseline="middle" class="tick">{{ t | compact }}</text>
          {% endif %}
        {% endfor %}

        {# x-axis #}
        <line x1="0" y1="{{ chart_h }}" x2="{{ chart_w }}" y2="{{ chart_h }}" class="axis" />

        {# bars + week overlays #}
        {% for inst in installs %}
          {% set i = loop.index0 %}
          {% set rem = removals[i] %}
          {% set up = upgrades[i] %}
          {% set net_val = ((inst - rem) | at_least(0)) %}
          {% set rem_draw = (rem | at_most(inst)) %}

          {% set net_h = (net_val / max_scale) * chart_h %}
          {% set rem_h = (rem_draw / max_scale) * chart_h %}

          {% set x = i * (bar_w + gap) %}
          {% set y_net = chart_h - net_h %}
          {% set y_rem = y_net - rem_h %}
          {% set slice_w = (i < (count - 1)) and (bar_w + gap) or bar_w %}

          <g class="week">
            {# subtle hover background spanning the full slice #}
            <rect x="{{ x }}" y="0" width="{{ slice_w }}" height="{{ chart_h }}" class="week-slice-bg" />

            {# grid line #}
            <clipPath id="clip-week-{{ i }}">
              <rect x="{{ x }}" y="0" width="{{ slice_w }}" height="{{ chart_h }}" />
            </clipPath>
            <g clip-path="url(#clip-week-{{ i }})">
              {% for gi in range(0, target + 1) %}
                {% set gt = gi * step %}
                {% set gy = chart_h - (gt / max_scale) * chart_h %}
                <line x1="0" y1="{{ gy }}" x2="{{ chart_w }}" y2="{{ gy }}" class="grid" />
              {% endfor %}
            </g>

            {# the actual bars #}
            <rect x="{{ x }}" y="{{ y_net }}" width="{{ bar_w }}" height="{{ net_h }}" class="bar bar-net">
              <title>{{ dates[i] }}: installs: {{ inst | grouping }}, removals: {{ rem | grouping }}, upgrades: {{ up | grouping }}</title>
            </rect>
            <rect x="{{ x }}" y="{{ y_rem }}" width="{{ bar_w }}" height="{{ rem_h }}" class="bar bar-remove">
              <title>{{ dates[i] }}: installs: {{ inst | grouping }}, removals: {{ rem | grouping }}, upgrades: {{ up | grouping }}</title>
            </rect>

            {# third bar: invisible hit area from top to top of installs just for the tooltip #}
            {% set inst_h = (inst / max_scale) * chart_h %}
            {% set y_top_inst = chart_h - inst_h %}
            <rect x="{{ x }}" y="0" width="{{ bar_w }}" height="{{ y_top_inst }}" class="week-slice-hit">
              <title>{{ dates[i] }}: installs: {{ inst | grouping }}, removals: {{ rem | grouping }}, upgrades: {{ up | grouping }}</title>
            </rect>

          </g>
        {% endfor %}

        {# render empty week slices to fill padded area width a grid #}
        {% for i in range(count, padded_count) %}
          {% set x = i * (bar_w + gap) %}
          {% set slice_w = (i < (padded_count - 1)) and (bar_w + gap) or bar_w %}
          <g class="week">
            <clipPath id="clip-week-{{ i }}">
              <rect x="{{ x }}" y="0" width="{{ slice_w }}" height="{{ chart_h }}" />
            </clipPath>
            <g clip-path="url(#clip-week-{{ i }})">
              {% for gi in range(0, target + 1) %}
                {% set gt = gi * step %}
                {% set gy = chart_h - (gt / max_scale) * chart_h %}
                <line x1="0" y1="{{ gy }}" x2="{{ chart_w }}" y2="{{ gy }}" class="grid" />
              {% endfor %}
            </g>
          </g>
        {% endfor %}

        {# average lines (exclude running week at index 0)
           - installs: mean(installs[i]) for i >= 1
           - net installs: mean(max(installs[i] - removals[i], 0)) for i >= 1
        #}
        {% set count_excl0 = count - 1 %}
        {% if count_excl0 > 0 %}
          {% set sum_inst = 0 %}
          {% set sum_net = 0 %}
          {% for i in range(1, count_excl0 + 1) %}
            {% set inst = installs[i] %}
            {% set rem = removals[i] %}
            {% set net = ((inst - rem) | at_least(0)) %}
            {% set sum_inst = sum_inst + inst %}
            {% set sum_net = sum_net + net %}
          {% endfor %}
          {% set avg_inst = (sum_inst / count_excl0) %}
          {% set avg_net = (sum_net / count_excl0) %}
          {% set y_avg_inst = chart_h - (avg_inst / max_scale) * chart_h %}
          {% set y_avg_net = chart_h - (avg_net / max_scale) * chart_h %}
          <line x1="0" y1="{{ y_avg_inst }}" x2="{{ chart_w }}" y2="{{ y_avg_inst }}" class="avg-line avg-line-inst" />
          <line x1="0" y1="{{ y_avg_net }}" x2="{{ chart_w }}" y2="{{ y_avg_net }}" class="avg-line avg-line-net" />
        {% endif %}

        {# upgrades overlay #}
        {# right y-axis and labels for upgrades #}
        <line x1="{{ chart_w }}" y1="0" x2="{{ chart_w }}" y2="{{ chart_h }}" class="axis" />
        {% for i in range(0, target_r + 1) %}
          {% set tr = i * step_r %}
          {% set yr = chart_h - (tr / max_scale_r) * chart_h %}
          {% if (i % 2) == 0 %}
            <text x="{{ chart_w + 6 }}" y="{{ yr }}" text-anchor="start" dominant-baseline="middle" class="tick tick-right">{{ tr | compact }}</text>
          {% endif %}
        {% endfor %}

        {#
          upgrades line path (smoothed cubic Bézier via Catmull–Rom approximation)

          Basics:
          - A straight polyline would use SVG 'L' commands between points: M x0 y0 L x1 y1 L x2 y2 …
            That produces sharp corners. To smooth the line we switch to cubic Bézier segments ('C').
            We start with a first point (M), and then continue with two control points and a segment
            end-point (C).
            Refer: https://svg-tutorial.com/editor/cubic-bezier

          - For each curved segment from P1 to P2 we take four points P0, P1, P2, P3
            (clamping at the ends) and compute the two control points as:
              C1 = P1 + (P2 − P0) / 6
              C2 = P2 − (P3 − P1) / 6
            This is a common Catmull–Rom to Bézier conversion that yields a smooth line
            passing through all data points.
        #}
        {% set d = '' %}
        {% if count > 1 %}
          {# start at second point because week[0] is the running week #}
          {% set val1 = upgrades[1] %}
          {% set y_start = chart_h - (val1 / max_scale_r) * chart_h %}
          {% set x_start = 1 * (bar_w + gap) + (bar_w / 2) %}
          {#               ^ shift one bar to the right #}
          {% set d = 'M ' ~ x_start ~ ' ' ~ y_start %}

          {# build cubic segments, starting at i=1 to skip 0→1 #}
          {% for i in range(1, count - 1) %}
            {# indices p0, p1, p2, p3 (clamped) #}
            {% set i0 = ((i - 1) | at_least(1)) %}
            {% set i1 = i %}
            {% set i2 = i + 1 %}
            {% set i3 = ((i + 2) | at_most(count - 1)) %}

            {% set v0 = upgrades[i0] %}
            {% set v1 = upgrades[i1] %}
            {% set v2 = upgrades[i2] %}
            {% set v3 = upgrades[i3] %}

            {% set x0 = i0 * (bar_w + gap) + (bar_w / 2) %}
            {% set x1 = i1 * (bar_w + gap) + (bar_w / 2) %}
            {% set x2 = i2 * (bar_w + gap) + (bar_w / 2) %}
            {% set x3 = i3 * (bar_w + gap) + (bar_w / 2) %}

            {% set y0 = chart_h - (v0 / max_scale_r) * chart_h %}
            {% set y1 = chart_h - (v1 / max_scale_r) * chart_h %}
            {% set y2 = chart_h - (v2 / max_scale_r) * chart_h %}
            {% set y3 = chart_h - (v3 / max_scale_r) * chart_h %}

            {#
              Catmull–Rom → Bézier control points
              Intuition: Catmull–Rom defines the tangent at P1 as (P2−P0)/2 and at P2 as (P3−P1)/2
              (with unit spacing). A cubic Bézier's tangents are 3·(C1−P1) at the start and
              3·(P2−C2) at the end. T.i.:
                3·(C1−P1) = (P2−P0)/2
                   C1−P1  = (P2−P0)/6
                       C1 = P1 + (P2−P0)/6
              Likewise:
                3·(P2−C2) = (P3−P1)/2
                       C2 = P2 − (P3−P1)/6
            #}
            {% set c1x = x1 + (x2 - x0) / 6 %}
            {% set c1y = y1 + (y2 - y0) / 6 %}
            {% set c2x = x2 - (x3 - x1) / 6 %}
            {% set c2y = y2 - (y3 - y1) / 6 %}

            {% set d = d ~ ' C ' ~ c1x ~ ' ' ~ c1y ~ ' ' ~ c2x ~ ' ' ~ c2y ~ ' ' ~ x2 ~ ' ' ~ y2 %}
          {% endfor %}
        {% endif %}
        <path d="{{ d }}" class="upgrades-line" />

        {# Points with tooltips #}
        {% for val in upgrades %}
          {% set i = loop.index0 %}
          {% set y2 = chart_h - (val / max_scale_r) * chart_h %}
          {% set x2 = i * (bar_w + gap) + (bar_w / 2) %}
          {% set inst_i = installs[i] %}
          {% set rem_i = removals[i] %}
          <circle cx="{{ x2 }}" cy="{{ y2 }}" r="{{ upgrade_pt_r }}" class="upgrades-point">
            <title>{{ dates[i] }}: installs: {{ inst_i | grouping }}, removals: {{ rem_i | grouping }}, upgrades: {{ val | grouping }}</title>
          </circle>
        {% endfor %}
      </g>
    </svg>
  </div>
  {% endif %}
{% endmacro %}
