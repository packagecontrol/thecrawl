{% macro chart(weekly=[], removals=[], dates=[], upgrades=[]) %}
  {% set count = weekly | length %}
  {% set dates_count = dates | length %}
  {% if count > 0 and dates_count > 0 %}

  {# dimensions #}
  {% set bar_w = 12 %}
  {% set gap = 1 %}
  {% set upgrade_pt_r = 2.5 %}
  {% set top = 10 %}
  {% set bottom = 20 %}
  {% set left = 40 %}
  {% set right = 44 %}
  {% set chart_h = 120 %}
  {% set chart_w = (count * (bar_w + gap)) - gap %}
  {% set svg_w = left + chart_w + right %}
  {% set svg_h = top + chart_h + bottom %}

  {# compute max #}
  {% set maxv = 0 %}
  {% for v in weekly %}
    {% if v > maxv %}{% set maxv = v %}{% endif %}
  {% endfor %}

  {# choose nice step for ~5 ticks #}
  {#
    We want about 5 evenly spaced tick labels on the y-axis, regardless of
    the data magnitude. To achieve this we:

    1) Pick a target number of ticks (target = 5).
    2) Compute a rough step as ceil(max_value / target).
       This is the smallest step that could cover the range with ~target ticks
       but it may be an awkward number (e.g. 37, 413, 9876).
    3) Normalize the rough step to a “nice” human-friendly step using a
       1–2–5 sequence scaled by a power of 10. Concretely, we find the order of
       magnitude of rough, then round it up to one of {1, 2, 5} × 10^k.
       Examples: 37 → 50, 413 → 500, 9876 → 10000.
    4) Set the axis step = nice_step and the axis maximum (= scale) to
       max_scale = step × target. This ensures the top grid line lands on a
       clean number and we end up with ~target ticks.

    We apply the same method for the right axis (upgrades) independently so
    both series look well-scaled even if their magnitudes differ.
  #}
  {% set target = 5 %}
  {#
    Integer ceiling
    Example: maxv = 371, target = 5
      ceil(371 / 5) = ceil(74.2) = 75
      naive 371 // 5 = 74 (too small), which would under-estimate the step.
      integer form: (371 + 5 - 1) // 5 = 375 // 5 = 75
  #}
  {% set rough = (maxv + target - 1) // target %}
  {% set mag = 1 %}
  {% set digits = (('' ~ rough) | length) %}
  {% for i in range(1, digits) %}
    {% set mag = mag * 10 %}
  {% endfor %}
  {% set lead = (rough + mag - 1) // mag %}
  {% if lead <= 1 %}
    {% set step = 1 * mag %}
  {% elif lead <= 2 %}
    {% set step = 2 * mag %}
  {% elif lead <= 5 %}
    {% set step = 5 * mag %}
  {% else %}
    {% set step = 10 * mag %}
  {% endif %}
  {% set max_scale = step * target %}

  {# compute right-axis for upgrades #}
  {% set maxu = 0 %}
  {% for u in upgrades %}
    {% if u > maxu %}{% set maxu = u %}{% endif %}
  {% endfor %}

  {% set target_r = 5 %}
  {% set rough_r = (maxu + target_r - 1) // target_r %}
  {% set mag_r = 1 %}
  {% set digits_r = (('' ~ rough_r) | length) %}
  {% for i in range(1, digits_r) %}
    {% set mag_r = mag_r * 10 %}
  {% endfor %}
  {% set lead_r = (rough_r + mag_r - 1) // mag_r %}
  {% if lead_r <= 1 %}
    {% set step_r = 1 * mag_r %}
  {% elif lead_r <= 2 %}
    {% set step_r = 2 * mag_r %}
  {% elif lead_r <= 5 %}
    {% set step_r = 5 * mag_r %}
  {% else %}
    {% set step_r = 10 * mag_r %}
  {% endif %}
  {% set max_scale_r = step_r * target_r %}

  <div class="install-chart">
    <svg width="{{ svg_w }}" height="{{ svg_h }}" viewBox="0 0 {{ svg_w }} {{ svg_h }}" role="img" aria-label="Weekly installs">
      <g transform="translate({{ left }}, {{ top }})">
        {# y-axis line #}
        <line x1="0" y1="0" x2="0" y2="{{ chart_h }}" class="axis" />

        {# ticks and labels #}
        {% for i in range(0, target + 1) %}
          {% set t = i * step %}
          {% if t > max_scale %}{% set t = max_scale %}{% endif %}
          {% set y = chart_h - (t / max_scale) * chart_h %}
          <line x1="0" y1="{{ y }}" x2="{{ chart_w }}" y2="{{ y }}" class="grid" />
          {% if (i % 2) == 0 %}
            <text x="-6" y="{{ y }}" text-anchor="end" dominant-baseline="middle" class="tick">{{ t | compact }}</text>
          {% endif %}
        {% endfor %}

        {# bars #}
        {% for inst in weekly %}
          {% set i = loop.index0 %}
          {% set rem = (removals[i] or 0) %}
          {% set net_val = inst - rem %}
          {% if net_val < 0 %}{% set net_val = 0 %}{% endif %}
          {% set rem_draw = rem %}
          {% if rem_draw > inst %}{% set rem_draw = inst %}{% endif %}

          {% if max_scale > 0 %}
            {% set net_h = (net_val / max_scale) * chart_h %}
            {% set rem_h = (rem_draw / max_scale) * chart_h %}
          {% else %}
            {% set net_h = 0 %}
            {% set rem_h = 0 %}
          {% endif %}

          {% set x = i * (bar_w + gap) %}
          {% set y_net = chart_h - net_h %}
          {% set y_rem = y_net - rem_h %}

          <rect x="{{ x }}" y="{{ y_net }}" width="{{ bar_w }}" height="{{ net_h }}" class="bar bar-net">
            <title>{{ dates[i] }}: installs {{ inst | grouping }}, removals {{ rem | grouping }}</title>
          </rect>
          <rect x="{{ x }}" y="{{ y_rem }}" width="{{ bar_w }}" height="{{ rem_h }}" class="bar bar-remove">
            <title>{{ dates[i] }}: installs {{ inst | grouping }}, removals {{ rem | grouping }}</title>
          </rect>
        {% endfor %}

        {# right y-axis and labels for upgrades #}
        {% if (upgrades | length) > 0 and max_scale_r > 0 %}
          <line x1="{{ chart_w }}" y1="0" x2="{{ chart_w }}" y2="{{ chart_h }}" class="axis" />
          {% for i in range(0, target_r + 1) %}
            {% set tr = i * step_r %}
            {% if tr > max_scale_r %}{% set tr = max_scale_r %}{% endif %}
            {% set yr = chart_h - (tr / max_scale_r) * chart_h %}
            {# small tick marks on the right axis #}
            <line x1="{{ chart_w }}" y1="{{ yr }}" x2="{{ chart_w + 4 }}" y2="{{ yr }}" class="axis" />
            {% if (i % 2) == 0 %}
              <text x="{{ chart_w + 6 }}" y="{{ yr }}" text-anchor="start" dominant-baseline="middle" class="tick tick-right">{{ tr | compact }}</text>
            {% endif %}
          {% endfor %}

          {# upgrades line path #}
          {% set d = '' %}
          {% for val in upgrades %}
            {% set i = loop.index0 %}
            {% if max_scale_r > 0 %}
              {% set y2 = chart_h - (val / max_scale_r) * chart_h %}
            {% else %}
              {% set y2 = chart_h %}
            {% endif %}
            {% set x2 = i * (bar_w + gap) + (bar_w / 2) %}
            {% if i == 0 %}
              {% set d = 'M ' ~ x2 ~ ' ' ~ y2 %}
            {% else %}
              {% set d = d ~ ' L ' ~ x2 ~ ' ' ~ y2 %}
            {% endif %}
          {% endfor %}
          <path d="{{ d }}" class="upgrades-line" />

          {# Points to host tooltips #}
          {% for val in upgrades %}
            {% set i = loop.index0 %}
            {% if max_scale_r > 0 %}
              {% set y2 = chart_h - (val / max_scale_r) * chart_h %}
            {% else %}
              {% set y2 = chart_h %}
            {% endif %}
            {% set x2 = i * (bar_w + gap) + (bar_w / 2) %}
            <circle cx="{{ x2 }}" cy="{{ y2 }}" r="{{ upgrade_pt_r }}" class="upgrades-point">
              <title>{{ dates[i] }}: upgrades {{ val | grouping }}</title>
            </circle>
          {% endfor %}
        {% endif %}
      </g>
    </svg>
  </div>
  {% endif %}
{% endmacro %}
