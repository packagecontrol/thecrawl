---
title: Labels in Package Control R
layout: layout.njk
date: Last Modified
---

{% import "packages/macros.njk" as pack %}

<form name="search" role="search" aria-label="Label search">
  <h1>Labels</h1>

  <div class="search-controls">
    <label for="search-field" class="screenreader-only">Search</label>
    <input type="search" autocomplete="off" name="q" id="search-field" placeholder="Search {{ collections.labels | length }} labels…">
    <div class="sort-toggle" data-sort-controls role="group" aria-label="Sort labels">
      <button type="button" data-sort-option="name" class="is-active" aria-pressed="true">
        By Name
      </button>
      <span class="sort-toggle-separator" aria-hidden="true">|</span>
      <button type="button" data-sort-option="usage" aria-pressed="false">
        By Popularity
      </button>
    </div>
  </div>

  <div class="search-subcontrols">
    <button type="button" class="usage-toggle is-active" data-omit-single aria-pressed="true">
      Omitting labels with only one usage
    </button>
  </div>
</form>

<section name="labels">
  <h2 data-list-target="counter">List</h2>
  <ul class="grid">
    {% for item in collections.labels %}
      <li>
        {% set q = pack.searchQueryFor('label', item.key) %}
        <a {{ "id=main-content" if loop.index0 == 0 }} data-name="{{ item.key }}" data-usage="{{ item.count }}" class="button label" href="/?q={{ q }}">
          {% set icon_id = item.key | label_icon_id %}
          {% if icon_id %}
            {% set canonical = icon_id | replace('label-icon-', '') %}
            <svg class="label-icon label-icon--{{ canonical }}" aria-hidden="true">
              <use href="/static/label-icons.svg#{{ icon_id }}"></use>
            </svg>
          {% endif %}
          {{ item.key }}
          <span class="count">{{ item.count }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<script src="{{ '/static/labels.js' | bust }}" type="module" async></script>
