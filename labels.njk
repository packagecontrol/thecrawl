---
title: Labels in Package Control R
layout: layout.njk
date: Last Modified
page_type: labels
---

{% import "packages/macros.njk" as pack %}
{% import "util/macros.njk" as util %}

<form name="search" role="search" aria-label="Label search">
  <h1>Labels</h1>

  <div class="search-controls">
    <label for="search-field" class="screenreader-only">Search</label>
    <span class="input-with-clearance">
      <input type="search" autocomplete="off" name="q" id="search-field" placeholder="Search {{ collections.labels | length }} labels…">
      <button class="clear-btn" type="button" aria-label="Clear search" tabindex="-1" onclick="const input=document.getElementById('search-field'); input.value=''; input.dispatchEvent(new Event('input', { bubbles: true })); input.focus();">
        {{ util.icon('x-circle-fill') }}
      </button>
    </span>
    <div class="sort-toggle" data-sort-controls role="group" aria-label="Sort labels">
      <button type="button" data-sort-option="name" class="is-active" aria-pressed="true">
        By Name
      </button>
      <span class="sort-toggle-separator" aria-hidden="true">|</span>
      <button type="button" data-sort-option="usage" aria-pressed="false">
        By Popularity
      </button>
    </div>
  </div>

  <div class="search-subcontrols">
    <button type="button" class="usage-toggle" data-omit-control aria-pressed="true">
      Omitting labels with only one usage
    </button>
    <script>
      {
        if (document.documentElement.classList.contains('initializing')) {
          document.querySelector('[data-omit-control]').setAttribute('aria-pressed', 'false')
        }
      }
    </script>
  </div>
</form>

<section name="labels">
  <h2 data-list-target="counter">List</h2>
  <ul class="grid">
    {% for item in collections.labels %}
      {% set omitted_by_default = item.count <= 1 %}
      <li{% if omitted_by_default %} style="display:none"{% endif %}>
        {% set q = pack.searchQueryFor('label', item.key) %}
        <a {{ "id=main-content" if loop.index0 == 0 }} data-name="{{ item.key }}" data-usage="{{ item.count }}" class="button label" href="/?q={{ q }}">
          {% set icon_id = item.key | label_icon_id %}
          {% if icon_id %}
            {% set tint = item.key | label_icon_tint %}
            {% set icon_sprite = item.key | label_icon_sprite %}
            <svg class="label-icon{{ (' label-icon--' ~ tint) if tint }}" aria-hidden="true">
              <use href="/{{ icon_sprite | data_bust }}#{{ icon_id }}"></use>
            </svg>
          {% endif %}
          {{ item.key }}
          <span class="count">{{ item.count }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<script src="{{ '/static/labels.js' | bundled }}" type="module" async></script>
