---
layout: layout.njk
title: Status
description: "Latest crawler runs and notes."
---

<div class="status-chart" data-status-chart aria-hidden="true">
  <svg role="presentation"></svg>
</div>

<section class="status-page">
  <div class="pager-header">
    <div class="status-heading" role="heading" aria-level="2">
      <span class="status-badge status-badge-muted" data-status-badge></span>
      <span class="status-label" data-status-label></span>
    </div>

    <div class="pager-pagination" aria-label="Log navigation">
      <span class="date-indicator" data-status-date></span>
      <div class="button-group">
        <button type="button" class="button" data-control="prev" aria-label="Previous entry" disabled>
          <span class="pager-nav-symbol">‹</span>
        </button>
        <button type="button" class="button" data-control="next" aria-label="Next entry" disabled>
          <span class="pager-nav-symbol">›</span>
        </button>
        <button type="button" class="button" data-control="last" aria-label="Newest entry" disabled>
          <span class="pager-nav-symbol">»</span>
        </button>
      </div>
    </div>
  </div>

  <div class="status-notes" id="status-notes">
    <p></p>
  </div>
</section>

<script src="{{ '/static/status.js' | bust }}" type="module" async></script>
