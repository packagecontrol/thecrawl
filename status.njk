---
layout: layout.njk
title: Status
description: "Latest crawler runs and notes."
---

{% set latest = logs.latest or {} %}
{% set conclusion = latest.conclusion | default('') | lower %}
{% if conclusion == 'success' %}
  {% set badge_class = 'status-badge-success' %}
{% elseif conclusion in ['failure', 'failed', 'cancelled', 'timed_out'] %}
  {% set badge_class = 'status-badge-error' %}
{% elseif conclusion in ['action_required', 'neutral', 'stale'] %}
  {% set badge_class = 'status-badge-warning' %}
{% elseif conclusion %}
  {% set badge_class = 'status-badge-muted' %}
{% else %}
  {% set badge_class = 'status-badge-muted' %}
{% endif %}
<section class="status-page">
  <div class="pager-header status-header">
    <div class="status-heading" role="heading" aria-level="2">
      <span class="status-badge {{ badge_class }}" data-status-badge>
        {{ latest.conclusion or '—' }}
      </span>
    </div>

    <div class="status-right">
      <span class="status-date" data-status-date></span>
      <div class="pager-pagination status-pagination" aria-label="Log navigation">
        <div class="button-group">
          <button type="button" class="button" data-control="prev" aria-label="Previous entry" disabled>
            <span class="pager-nav-symbol">‹</span>
          </button>
          <button type="button" class="button" data-control="next" aria-label="Next entry" disabled>
            <span class="pager-nav-symbol">›</span>
          </button>
          <button type="button" class="button" data-control="last" aria-label="Newest entry" disabled>
            <span class="pager-nav-symbol">»</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="status-notes" id="status-notes">
    {% if logs.latestHtml %}
      {{ logs.latestHtml | safe }}
    {% else %}
      <p>Loading logs…</p>
    {% endif %}
  </div>
</section>

<script src="{{ '/static/status.js' | bust }}" type="module" async></script>
