---
layout: layout.njk
title: Status
description: "Latest crawler runs and notes."
---

<section class="status-page">
  <div class="pager-header status-header">
    <div class="status-heading" role="heading" aria-level="2">
      <span class="status-badge status-badge-muted" data-status-badge>—</span>
    </div>

    <div class="status-right">
      <span class="status-date" data-status-date>Loading latest run…</span>
      <div class="pager-pagination status-pagination" aria-label="Log navigation">
        <div class="button-group">
          <button type="button" class="button" data-control="prev" aria-label="Previous entry">
            <span class="pager-nav-symbol">‹</span>
          </button>
          <button type="button" class="button" data-control="next" aria-label="Next entry">
            <span class="pager-nav-symbol">›</span>
          </button>
          <button type="button" class="button" data-control="last" aria-label="Newest entry">
            <span class="pager-nav-symbol">»</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="status-notes" id="status-notes">
    <p>Loading logs…</p>
  </div>
</section>

<link rel="stylesheet" href="{{ '/static/style/status.css' | bust}}">
<script src="{{ '/static/status.js' | bust }}" type="module" async></script>
